{
  "info": {
    "_postman_id": "c1f8d689-53b7-4b77-8d07-2804b4d67e2a",
    "name": "Task Assignment API",
    "description": "Postman collection for the Task Assignment & Developer Matching API.\nBase URL defaults to http://localhost:5001.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Check if the backend server is up and responsive."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Skills",
      "item": [
        {
          "name": "Get All Skills",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/skills",
              "host": ["{{baseUrl}}"],
              "path": ["skills"]
            },
            "description": "Fetch all available skills (e.g. Frontend, Backend)."
          },
          "response": []
        },
        {
          "name": "Get Skill by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/skills/:id",
              "host": ["{{baseUrl}}"],
              "path": ["skills", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Skill ID"
                }
              ]
            },
            "description": "Retrieve details for a specific skill by ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Developers",
      "item": [
        {
          "name": "Get All Developers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/developers",
              "host": ["{{baseUrl}}"],
              "path": ["developers"]
            },
            "description": "Fetch all developers along with their acquired skills."
          },
          "response": []
        },
        {
          "name": "Get Developer by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/developers/:id",
              "host": ["{{baseUrl}}"],
              "path": ["developers", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Developer ID"
                }
              ]
            },
            "description": "Retrieve a developer and their skills by ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "Get All Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            },
            "description": "Fetch all tasks including required skills and assigned developer."
          },
          "response": []
        },
        {
          "name": "Get Task by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks/:id",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Task ID"
                }
              ]
            },
            "description": "Retrieve task details including required skills and assigned developer."
          },
          "response": []
        },
        {
          "name": "Create Task (with skills)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement User Authentication\",\n  \"status\": \"To-do\",\n  \"task_skills\": [1, 2]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            },
            "description": "Create a new task with required skill IDs (e.g. 1 = Frontend, 2 = Backend)."
          },
          "response": []
        },
        {
          "name": "Assign Developer to Task",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"developer_id\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/:id/assign",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", ":id", "assign"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Task ID"
                }
              ]
            },
            "description": "Assign a developer to the task. The developer must possess all skills required by the task (e.g., Carol ID 3 has both Frontend & Backend)."
          },
          "response": []
        },
        {
          "name": "Assign Developer - Lacks Skills (Expect 400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"developer_id\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/:id/assign",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", ":id", "assign"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Task ID that requires Frontend (Skill 1)"
                }
              ]
            },
            "description": "Tests skill validation: Bob (ID 2) only has Backend, so assigning to a task requiring Frontend should return 400 with missing skills."
          },
          "response": []
        },
        {
          "name": "Update Task Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", ":id", "status"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Task ID"
                }
              ]
            },
            "description": "Update task status (e.g., 'To-do', 'In Progress', 'Done')."
          },
          "response": []
        }
      ]
    }
  ]
}
